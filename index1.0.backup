local dt = require("static.metadata.datacollection")
-- goal: make a file previewer based on metadata

local M  = {}

local state = {
    buffers = {},
    wins = {}
}

M.updateStateBuffers = function(buf)
    table.insert(state.buffers, buf)
end

M.updateStateWins = function(tab)
    state.wins = {}
    for _, win in pairs(vim.api.nvim_tabpage_list_wins(tab)) do
        if vim.api.nvim_win_is_valid(win) then
            table.insert(state.wins, win)
        end
    end
end

M.modBufConfig = function(bufName, func)
    local buf = vim.api.nvim_get_buf_by_name(bufName)
    if not vim.api.nvim_buf_is_valid(buf) then
        print("Buffer " .. bufName .. " does not exist.")
        return
    end

    -- set options for the buffer
    vim.api.nvim_buf_set_option(buf, "modifiable", true)
    -- call the function to set additional options
    if func and type(func) == "function" then
        func(buf)
    end
    vim.api.nvim_buf_set_option(buf, "modifiable", false)
end

M.changeBufContent = function(bufName, content)
    local buf = vim.api.nvim_get_buf_by_name(bufName)
    if not vim.api.nvim_buf_is_valid(buf) then
        print("Buffer " .. bufName .. " does not exist.")
        return
    end

    -- set the buffer to be modifiable
    vim.api.nvim_buf_set_option(buf, "modifiable", true)
    
    -- clear the buffer and set new content
    vim.api.nvim_buf_set_lines(buf, 0, -1, false, content)

    -- set the buffer to be unmodifiable again
    vim.api.nvim_buf_set_option(buf, "modifiable", false)
end

M.moveRight = function(currentBuf)
    print(vim.inspect(vim.api.nvim_win_get_width(vim.api.nvim_get_current_win())))
end

M.moveLeft = function(currentBuf)
    if vim.api.nvim_get_buf_by_name("links") == buf then
        print("Cannot move left from links buffer")
        return
    end 
    print(vim.inspect(vim.api.nvim_win_get_width()))
end

M.createBuf = function(name)
    local buf = vim.api.nvim_create_buf(true, true) -- create a new buffer
    vim.api.nvim_buf_set_name(buf, name) -- set the name of the buffer
    vim.api.nvim_buf_set_option(buf, "filetype", "md") -- set the filetype to links

    vim.keymap.set("n", "l", function() M.moveRight(buf) end, { buffer = buf, noremap = true, silent = true })
    vim.keymap.set("n", "h", function() M.moveLeft(buf) end, { buffer = buf, noremap = true, silent = true })

    return buf
end

M.zapProgram = function()
    for _, win in pairs(state.wins) do
        if vim.api.nvim_win_is_valid(win) then
            vim.api.nvim_win_close(win, true)
        end
    end
    for _, buf in pairs(state.buffers) do
        if vim.api.nvim_buf_is_valid(buf) then
            vim.api.nvim_buf_delete(buf, { force = true })
        end
    end
    state.wins = {}
    state.buffers = {}
    vim.api.nvim_del_augroup_by_name("Index") -- remove the autocmd group
    print("Zapped all windows and buffers and cmd!")
end

M.index = function()
    vim.cmd("tabe")
    table.insert(state.wins, vim.api.nvim_get_current_win()) -- add current window to state.wins
    local tab = vim.api.nvim_get_current_tabpage()
    local scracthBuf = vim.api.nvim_get_current_buf()
    print("new tab: " .. tostring(tab))
    print("current window: " .. tostring(vim.api.nvim_get_current_win()))
    local linksWin = vim.api.nvim_get_current_win()
    local linksBuf = M.createBuf("links")
    table.insert(state.buffers, linksBuf) -- add the links buffer to state.buffers, added manually cause the autocmds are not set yet.
    vim.api.nvim_win_set_buf(linksWin, linksBuf) 
    -- the reason the scratch buffer is deleted here is because we dont need it and if we deleted when we opened the tab, no buffer will be loaded on to the window, meaning the window will get closed and so is the tab. We havent setted our autocmds yet, meaning the program just wont work. This is kinda of a quirck of neovim windows and buffers.
    vim.api.nvim_buf_delete(scracthBuf, { force = true }) -- delete the scratch buffer

    -- autocmds
    local indexau = vim.api.nvim_create_augroup("Index", { clear = true }) 

    vim.api.nvim_create_autocmd({"TabLeave", "TabClosed"}, {
        group = indexau,
        callback = function(ev)
            if vim.api.nvim_get_current_tabpage() == tab then
                M.zapProgram()
            end
        end
    })

    
    vim.api.nvim_create_autocmd("WinNew", {
        group = indexau,
        callback = function()
            print("new window: " .. tostring(vim.api.nvim_get_current_win()))
            M.updateStateWins(tab)
        end
    })

    vim.api.nvim_create_autocmd("BufNew", {
        group = indexau,
        callback = function(ev)
            print("new buffer: " .. tostring(ev.buf))
            M.updateStateBuf(ev.buf)
        end
    })
    vim.api.nvim_create_autocmd("WinClosed", {
        group = indexau,
        callback = function(ev)
            print("closed window: " .. tostring(ev.win))
            if not (vim.api.nvim_tabpage_is_valid(tab)) and (vim.api.nvim_get_current_tabpage() == tab) then
                vim.cmd("tabclose")
                M.zapProgram()
            else
                M.zapProgram()
            end
        end
    })
end

--M.index()

return M
