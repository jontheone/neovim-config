local dt = require("static.metadata.datacollection")
-- goal: make a file previewer based on metadata

local M  = {}

vim.g.index_active = false
local ID

local state = {
    wins = {},
    buffers = {}
}

M.GenId = function()
    if not ID then
        ID = 1
        return ID
    else
        ID = ID + 1
        return ID
    end
end

M.updateStateBuffers = function(buf)
    table.insert(state.buffers, buf)
end

-- this updates an already existing window with new information, usually called whenever we attach to the program again
M.updateStateWinsInfo = function(id, win, buf, opts, focus)
    assert(id, "You need to specify an id in order to update a window's info")
    assert(win, "You need to specify the new windows number in order to update information about the win")
    assert(buf, "A window cannot exist without a buffer")
    opts = opts or vim.api.nvim_win_get_config(win)
    focus = focus or true
    for i, winInfo in ipairs(state.wins) do
        if winInfo.id == id then
            print("updating info in id: " .. id .. "\nwith win: " .. win .. "\nbuf: " .. buf .. "\nopts: " .. vim.inspect(opts) .. "\nfocus: " .. tostring(focus))
            state.wins[i].win = win
            state.wins[i].buf = buf
            state.wins[i].opts = opts
            state.wins[i].focus = focus
            print("\n\nFinished updating proccess result:\n" .. vim.inspect(state.wins))
            break
        end
    end
end

-- this updates the state wins list with a new window
M.updateStateWins = function(win, buf, opts, focus, id)    
    win = win or error("Window is not valid")
    buf = buf or error("Buffer is not valid")
    for i, win in ipairs(state.wins) do
        if win.id == id then
            M.zapProgram()
            error("No window can have the same id", 2)
        end
    end
    local winInfo = {
        id = id,
        win = win,
        opts = opts or vim.api.nvim_win_get_config(win),
        buf = buf,
        focus = focus or false,
    }
    table.insert(state.wins, winInfo)
    print("Window created: " .. win)
    print("Updated state with new window: " .. vim.inspect(state.wins))
end

M.modBufConfig = function(bufName, func)
    local buf = vim.api.nvim_get_buf_by_name(bufName)
    if not vim.api.nvim_buf_is_valid(buf) then
        print("Buffer " .. bufName .. " does not exist.")
        return
    end

    -- set options for the buffer
    vim.api.nvim_buf_set_option(buf, "modifiable", true)
    -- call the function to set additional options
    if func and type(func) == "function" then
        func(buf)
    end
    vim.api.nvim_buf_set_option(buf, "modifiable", false)
end

M.changeBufContent = function(bufName, content)
    local buf = vim.api.nvim_get_buf_by_name(bufName)
    if not vim.api.nvim_buf_is_valid(buf) then
        print("Buffer " .. bufName .. " does not exist.")
        return
    end

    -- set the buffer to be modifiable
    vim.api.nvim_buf_set_option(buf, "modifiable", true)
    -- clear the buffer and set new content
    vim.api.nvim_buf_set_lines(buf, 0, -1, false, content)

    -- set the buffer to be unmodifiable again
    vim.api.nvim_buf_set_option(buf, "modifiable", false)
end

M.moveRight = function(currentBuf)
    print("moving right")
    local bufName = vim.api.nvim_buf_get_name(currentBuf)
    if bufName:match("links") then
        print("moving right of links")
        for i=1, #state.buffers do
            if vim.api.nvim_buf_get_name(state.buffers[i]) == "topic" then
                for i, winInfo in ipairs(state.wins) do
                    if winInfo.buf == state.buffers[i] then
                        vim.api.nvim_set_current_win(winInfo.win)
                        print('found buffer "topic" associated with win: ', winInfo.win)
                        return
                    end
                end
            end
        end
        print("no topic buffer found, creating a new one")
        M.buildWin(M.createBuf("topic"), nil, {title="topic"}, "true")
    elseif bufName:match("topic") then
        print("moving right of topic")

    elseif bufName:match("files") then
        print("moving right of files")

    end
end

M.moveLeft = function(currentBuf)
    if vim.api.nvim_get_buf_by_name("links") == buf then
        print("Cannot move left from links buffer")
        return
    end 
    if vim.api.nvim_buf_get_name(currentBuf) == "topic" then

    end
end

M.getNextColPos = function()
    if (#state.wins) == 0 then
        return 1 -- if no windows, start at column 1
    else
        print("Getting next column position")
        local wins_pos = {}
        for i, win in ipairs(state.wins) do
            if vim.api.nvim_win_is_valid(win.win) then
                table.insert(wins_pos, (win.opts.col + win.opts.width) )
            end
        end
        return math.max(unpack(wins_pos)) + 2 -- WARNING: method unpack deprecated in lua 5.2, use table.unpack in lua 5.3+
    end
end


M.stringify = function(bool)
    return bool and "true" or "false"
end

-- if an id is provided, then the whole funcition changes, now we are talking about building a window that already exists.
-- Because of that the argument "args" now is already the opts and not a table containing information about certain fields
-- the reason its structure like that is more of a quirck of neovim. Neovim windows are supposed to be ephemeral.
-- However in our program we want windows to be as persistent interchangable  menus.
M.buildWin = function(buf, id, args, focus)
    assert(type(focus) == "string", "focus must be a string of false or true")
    local args = args or {}
    focus = focus == "true" and true or false -- focus status is going to be stored as a string that represents a boolean
    args.title = args.title or ""
    args.height = args.height or math.floor(vim.o.lines * 0.8)
    args.width = args.width or 30
    args.row = args.row or 1
    args.col = args.col or M.getNextColPos()
    local opts = id and args or{
        relative = "editor",
        width = args.width,
        height = args.height,
        row = args.row,
        col = args.col,
        style = "minimal",
        title = args.title,
        border = "rounded"
    }

    local win = vim.api.nvim_open_win(buf, focus, opts)

    if id then M.updateStateWinsInfo(id, win, buf, opts, M.stringify(focus)) else M.updateStateWins(win, buf, opts, M.stringify(focus), M.GenId()) end
    return win
end

M.createBuf = function(name)
    local buf = vim.api.nvim_create_buf(false, false) -- create a new buffer
    vim.api.nvim_buf_set_name(buf, name) -- set the name of the buffer
    vim.api.nvim_buf_set_option(buf, "filetype", "md") -- set the filetype to links

    vim.keymap.set("n", "l", function() M.moveRight(buf) end, { buffer = buf, noremap = true, silent = true })
    vim.keymap.set("n", "h", function() M.moveLeft(buf) end, { buffer = buf, noremap = true, silent = true })
    vim.keymap.set("n", "q", function() M.quitProgram() end, { buffer = buf, noremap = true, silent = true })

    M.updateStateBuffers(buf) -- update the state with the new buffer
    print("created new buffer with name: "..buf.." with name: "..name)
    return buf
end

M.quitProgram = function()
    for _, win in ipairs(state.wins) do
        if vim.api.nvim_win_is_valid(win.win) then
            vim.api.nvim_win_hide(win.win)
        end
    end
    vim.api.nvim_del_augroup_by_name("Index") -- remove the autocmd group
end

M.attachAgain = function()
    for i, win in ipairs(state.wins) do
        print("attaching to window with id: " .. win.id)
        M.buildWin(win.buf, win.id, win.opts, win.focus)
    end
end

M.zapProgram = function()
    for _, win in pairs(state.wins) do
        if vim.api.nvim_win_is_valid(win) then
            vim.api.nvim_win_close(win, true) 
        end
    end
    for _, buf in pairs(state.buffers) do
        if vim.api.nvim_buf_is_valid(buf) then
            vim.api.nvim_buf_delete(buf, { force = true })
        end
    end
    state.wins = {}
    state.buffers = {}
    vim.api.nvim_del_augroup_by_name("Index") -- remove the autocmd group
    vim.g.index_active = false
    print("Zapped all windows and buffers and cmd!")
end

M.index = function()
    if vim.g.index_active then
        M.attachAgain()
    else
        local buf = M.createBuf("links")
        local win = M.buildWin(buf, nil, { title = "Links", col = 1 }, "true")
        vim.g.index_active = true
    end

    -- autocmds
    local indexau = vim.api.nvim_create_augroup("Index", { clear = true })
    vim.api.nvim_create_autocmd("WinEnter", {
        group = indexau,
        callback = function()
            local currentWin = vim.api.nvim_get_current_win()
            for i, winInfo in ipairs(state.wins) do
                if winInfo.win == currentWin then
                    state.wins[i].focus = "true"
                else
                    state.wins[i].focus = "false"
                end
            end
            print("Focused window: " .. currentWin)
        end
    })

end

--M.index()

return M
